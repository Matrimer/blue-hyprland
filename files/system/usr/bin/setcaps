set_caps_if_present() {
    local caps="$1"
    local binary_path="$2"
    if [ -f "$binary_path" ]; then
        mount --bind -o rw "$binary_path" "$binary_path"

        echo "Setting caps $caps on $binary_path"
        setcap "$caps" "$binary_path"
        echo "Set caps $caps on $binary_path"

        umount "$binary_path"
    fi
}

set_caps_if_present "CAP_SYS_NICE=eip" "/usr/bin/gamescope"
set_caps_if_present "CAP_SYS_NICE=eip" "/usr/bin/gamemoderun-priority"
